# Generated by ccic — do not edit. Run `ccic regen` after changing .ccic.conf.
#
# Topology: the claude container sits on both networks; the data services sit
# only on `internal`, which has no route off the host. They are therefore
# reachable from the claude container and from nowhere else — not the host
# machine, not the internet.

services:
  claude:
    image: {{ .ImageName }}
    build:
      context: .
      dockerfile: Dockerfile.project
      args:
        CCIC_BASE: {{ .BaseImage }}
        USERNAME: {{ .User }}
        WORKSPACE: {{ .Cfg.Workspace }}
    hostname: {{ .Cfg.Suffix }}
    init: true
    stdin_open: true
    tty: true
    command: ["sleep", "infinity"]
{{- if .Cfg.Firewall.Enabled }}
    # Required only by the egress firewall.
    cap_add:
      - NET_ADMIN
      - NET_RAW
{{- end }}
    networks:
      - internal
      - egress
{{- if .Cfg.Network.Publish }}
    ports:
{{- range .Cfg.Network.Publish }}
      - "{{ . }}:{{ . }}"
{{- end }}
{{- else }}
    # No published ports, deliberately: the host runs its own copy of this
    # project and the container must never compete for one. Claude reports back
    # by writing images to {{ .Cfg.Isolation.Screenshots }} on the bind mount.
{{- end }}
    working_dir: {{ .Cfg.Workspace }}
    healthcheck:
      test: ["CMD", "test", "-f", "/tmp/ccic-ready"]
      interval: 1s
      timeout: 2s
      retries: 60
{{- if or .Cfg.Postgres.Enabled .Cfg.Redis.Enabled }}
    depends_on:
{{- if .Cfg.Postgres.Enabled }}
      db:
        condition: service_healthy
{{- end }}
{{- if .Cfg.Redis.Enabled }}
      redis:
        condition: service_healthy
{{- end }}
{{- end }}
    volumes:
      - {{ .HostDir }}:{{ .Cfg.Workspace }}:delegated
      # Claude Code's auth and settings; survives rebuilds, so you log in once.
      - claude-config:/home/{{ .User }}/.claude
      # Package-manager caches; turns most rebuilds from minutes into seconds.
      - caches:/home/{{ .User }}/.cache
{{- range .IsolationVolumes }}
      # Container-only: native extensions built here are Linux, the host's are
      # macOS, and sharing them corrupts both installs.
      - {{ .Volume }}:{{ .MountPath }}
{{- end }}
    environment:
      CCIC_USER: {{ .User }}
      CCIC_WORKSPACE: {{ .Cfg.Workspace }}
      CCIC_SCREENSHOT_DIR: {{ .ScreenshotDir }}
      CCIC_CHOWN_PATHS: "{{ .ChownPaths }}"
      CCIC_FIREWALL: "{{ if .Cfg.Firewall.Enabled }}1{{ else }}0{{ end }}"
      CCIC_FIREWALL_ALLOW: "{{ .FirewallAllow }}"

      # Both are needed to stay logged in across a rebuild: the OAuth token
      # lives in ~/.claude/.credentials.json but the account record lives in
      # ~/.claude.json, outside that directory. CLAUDE_CONFIG_DIR moves both
      # into the volume.
      CLAUDE_CONFIG_DIR: /home/{{ .User }}/.claude

      # Without this mise refuses to activate the project's mise.toml at runtime
      # and silently falls back to ccic's own node, so the toolchain installed
      # at build time never gets used.
      MISE_TRUSTED_CONFIG_PATHS: {{ .Cfg.Workspace }}

      TZ: {{ .Timezone }}
{{- if .Cfg.Git.Identity }}
      GIT_AUTHOR_NAME: "{{ .GitName }}"
      GIT_AUTHOR_EMAIL: "{{ .GitEmail }}"
      GIT_COMMITTER_NAME: "{{ .GitName }}"
      GIT_COMMITTER_EMAIL: "{{ .GitEmail }}"
{{- end }}

      # Build artefacts redirected out of the workspace wherever the toolchain
      # allows it; see [isolation] for the paths that cannot be redirected.
      BUNDLE_PATH: /home/{{ .User }}/.cache/bundle
      BUNDLE_APP_CONFIG: /home/{{ .User }}/.bundle
      UV_PROJECT_ENVIRONMENT: /home/{{ .User }}/.cache/venv
      PIP_CACHE_DIR: /home/{{ .User }}/.cache/pip
      CARGO_TARGET_DIR: /home/{{ .User }}/.cache/cargo-target
      npm_config_cache: /home/{{ .User }}/.cache/npm
{{- if .Cfg.Postgres.Enabled }}
      DATABASE_URL: {{ .DatabaseURL }}
      PGHOST: db
      PGUSER: {{ .Cfg.Postgres.User }}
      PGPASSWORD: {{ .Cfg.Postgres.Password }}
      PGDATABASE: {{ .Cfg.Postgres.Database }}
{{- end }}
{{- if .Cfg.Redis.Enabled }}
      REDIS_URL: redis://redis:6379/0
{{- end }}
{{- range .PassthroughEnv }}
      {{ . }}
{{- end }}
{{- if .Cfg.Env.File }}
    env_file:
      - path: {{ .EnvFile }}
        required: false
{{- end }}

{{- if .Cfg.Postgres.Enabled }}

  db:
    image: postgres:{{ .Cfg.Postgres.Version }}-bookworm
    networks:
      - internal
    environment:
      POSTGRES_USER: {{ .Cfg.Postgres.User }}
      POSTGRES_PASSWORD: {{ .Cfg.Postgres.Password }}
      POSTGRES_DB: {{ .Cfg.Postgres.Database }}
    volumes:
      # Version-dependent: postgres 18 took ownership of the layout below
      # /var/lib/postgresql so `pg_upgrade --link` can work, and refuses to
      # initialise if the old .../data path is mounted instead.
      - pgdata:{{ .PGDataMount }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ .Cfg.Postgres.User }}"]
      interval: 2s
      timeout: 3s
      retries: 30
{{- end }}
{{- if .Cfg.Redis.Enabled }}

  redis:
    image: redis:{{ .Cfg.Redis.Version }}-alpine
    networks:
      - internal
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 30
{{- end }}

networks:
  internal:
    internal: true
  egress: {}

volumes:
  claude-config:
  caches:
{{- range .IsolationVolumes }}
  {{ .Volume }}:
{{- end }}
{{- if .Cfg.Postgres.Enabled }}
  pgdata:
{{- end }}
{{- if .Cfg.Redis.Enabled }}
  redisdata:
{{- end }}
